# MinIO Configuration for Parquet File Upload
# Copy this file to .env and fill in your actual credentials

# MinIO server endpoint (without http://)
# Format: host:port
# Example: 100.107.134.23:9000
MINIO_ENDPOINT=100.107.134.23:9000

# MinIO access credentials
# Get these from your MinIO admin console
MINIO_ACCESS_KEY=your_access_key_here
MINIO_SECRET_KEY=your_secret_key_here

# Note: The bucket name is configured in the script (default: flight-parquet)
# You can override it with --bucket flag when running the script
